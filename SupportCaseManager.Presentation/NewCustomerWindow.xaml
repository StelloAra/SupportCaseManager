<?xml version="1.0" encoding="utf-8"?>

<Window
    x:Class="SupportCaseManager.Presentation.NewCustomerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Ny kund">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>


        <!-- Rubrik -->

        <TextBlock
            Text="Ny kund"
            FontSize="24"
            FontWeight="SemiBold" />


        <!-- Namn -->

        <TextBox
            x:Name="NameTextBox"
            Grid.Row="1"
            Header="Namn"
            PlaceholderText="Ange kundens namn"
            Margin="0,24,0,0" />


        <!-- E-post -->

        <TextBox
            x:Name="EmailTextBox"
            Grid.Row="2"
            Header="E-post"
            PlaceholderText="Ange kundens e-post"
            Margin="0,16,0,0" />


        <!-- Knappar -->

        <StackPanel
            Grid.Row="3"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Spacing="12"
            Margin="0,24,0,0">

            <Button
                Content="Avbryt"
                Click="CancelButton_Click" />

            <Button
                Content="Spara"
                Click="SaveButton_Click" />

        </StackPanel>

    </Grid>

</Window>